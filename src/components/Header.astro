---
const nav = [
  { label: 'Énergie Côte Sud', href: '/a-propos' },
  { label: 'Nos métiers', href: '/nos-metiers' },
  { label: 'Démarche RSE', href: '/demarche-rse' },
  { label: 'Nos références', href: '/nos-references' },
  { label: 'Rejoindre ECS', href: '/rejoindre-ecs' },
  { label: 'Contact', href: '/contact' }
];
---

<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="container-ecs flex items-center justify-between py-4">
    <a href="/" class="flex items-center gap-3">
      <img src="/logo-ecs.png" alt="Énergie Côte Sud" class="h-10 md:h-12 w-auto" />
    </a>
    <nav class="hidden lg:flex items-center gap-7">
      {nav.map(item => (
        <a href={item.href} class="text-sm font-medium text-gray-700 hover:text-ecs-green transition-colors">
          {item.label}
        </a>
      ))}
      <a href="/contact" class="btn-primary !py-2 !px-4 !text-sm">Devis</a>
    </nav>
    <button class="lg:hidden text-ecs-green" aria-label="Menu" id="menu-btn">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>
  <nav id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100">
    <div class="container-ecs py-4 flex flex-col gap-3">
      {nav.map(item => (
        <a href={item.href} class="text-sm font-medium text-gray-700 hover:text-ecs-green py-2">
          {item.label}
        </a>
      ))}
      <a href="/contact" class="btn-primary !py-2 !text-sm w-full">Demander un devis</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
